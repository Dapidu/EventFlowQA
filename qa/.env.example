# Modele de configuration des tests. Copier en qa/.env et completer.
# Ne jamais versionner qa/.env (voir .gitignore). En CI, les mots de passe
# viennent des secrets GitHub Actions (ADMIN_PASSWORD, ORGA_PASSWORD, CLIENT_PASSWORD).

API_URL=http://localhost:8000
BASE_URL=http://localhost:5173
DB_URL=postgresql+psycopg2://<utilisateur>:<mot_de_passe>@localhost:5432/eventflow

ADMIN_EMAIL=admin@eventflow.test
ADMIN_PASSWORD=
ORGA_EMAIL=orga@eventflow.test
ORGA_PASSWORD=
CLIENT_EMAIL=client@eventflow.test
CLIENT_PASSWORD=
